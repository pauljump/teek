{
  "name": "teek",
  "version": "3.0.0-alpha.0",
  "private": true,
  "description": "Falsifiable cognitive profiles of real people, built from cited public sources and scored against held-out decisions",
  "type": "module",
  "license": "MIT",
  "author": "Paul Jump",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node packages/ledger/validate-evidence-ledger.mjs",
    "roster": "tsx cli/index.ts roster",
    "decay": "tsx cli/index.ts decay"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@9.0.0"
}
